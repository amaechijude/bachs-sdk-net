<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Properties -->
    <PackageId>Bachs.Sdk</PackageId>
    <Version>1.0.1</Version>
    <Title>Bachs SDK for .NET</Title>
    <Authors>Amaechi Ugwu</Authors>
    <Copyright>Copyright (c) Amaechi Ugwu 2026</Copyright>
    <Description>Developer-first .NET 10 and 11 SDK for the Bachs payments and billing API: hosted checkout, subscriptions, and webhooks. Not affiliated with Bachs. API docs: https://docs.bachs.io/</Description>
    <PackageTags>bachs;payments;billing;checkout;subscriptions;fintech;sdk;webhooks;dotnet;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/amaechijude/bachs-sdk-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/amaechijude/bachs-sdk-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="..\..\README.md"
      Pack="true"
      PackagePath="\"
      Condition="Exists('..\..\README.md')"
    />
  </ItemGroup>

  <!-- One Http.Resilience major version per target framework -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
  </ItemGroup>
</Project>
